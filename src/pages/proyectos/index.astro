---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';
import { Image } from 'astro:assets';
import { imageSource } from '../../lib/projectImages';
---
<Layout title="Proyectos | OWN Architecture">
  <section class="projects-page page-padding">
    <div class="section-heading" data-reveal><h1>PROYECTOS</h1><span class="eyebrow">Arquitectura residencial / 01 — {String(projects.length).padStart(2, '0')}</span></div>
    <div class="projects-grid grid grid-cols-1 md:grid-cols-3 gap-x-7 gap-y-12">
      {projects.map((project, i) => <article class="project-card" data-reveal>
        <a href={`/proyectos/${project.slug}/`} class="project-swatch" aria-label={`Ver ${project.title}`}>
          <Image src={imageSource(project.cover)} alt={project.title} loading={i < 3 ? 'eager' : 'lazy'} widths={[480, 768, 1200]} sizes="(max-width: 767px) 88vw, 30vw" format="webp" quality={85} />
          <div class="swatch-caption"><h2>{project.title}</h2><span aria-hidden="true">↗</span></div>
        </a>
        <div class="project-meta"><span>{String(i + 1).padStart(2, '0')}</span><span>{project.location}</span></div>
      </article>)}
    </div>
  </section>
  <Footer />
</Layout>
